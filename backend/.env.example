# ─── App ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ─── MongoDB ───────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/hotel_management

# ─── Redis (optional) ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ───────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES=15m
JWT_REFRESH_SECRET=change_this_too
JWT_REFRESH_EXPIRES=7d

# ─── Email (optional) ──────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Hotel Management <noreply@hotel.com>"

# ─── Stripe (optional) ─────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ─── Rate Limits ───────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Testing ───────────────────────────────────────────────────
MONGO_URI_TEST=mongodb://localhost:27017/hotel_management_test